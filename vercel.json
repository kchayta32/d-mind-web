{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/rag-web",
      "status": 307,
      "headers": {
        "Location": "/rag-web/"
      }
    },
    {
      "src": "/rag-web/(.*)",
      "dest": "/rag-web/$1"
    },
    {
      "src": "/rag-web/",
      "dest": "/rag-web/index.html"
    },
    {
      "src": "/arena",
      "status": 307,
      "headers": {
        "Location": "/arena/"
      }
    },
    {
      "src": "/arena/(.*)",
      "dest": "/arena/$1"
    },
    {
      "src": "/arena/",
      "dest": "/arena/index.html"
    },
    {
      "src": "/news_web",
      "status": 307,
      "headers": {
        "Location": "/news_web/"
      }
    },
    {
      "src": "/news_web/(.*)",
      "dest": "/news_web/$1"
    },
    {
      "src": "/news_web/",
      "dest": "/news_web/index.html"
    },
    {
      "src": "/((?!api|rag-web|arena|news_web|diagrams|assets|images|lovable-uploads|favicon\\.ico|robots\\.txt|.*\\..*).*)",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}